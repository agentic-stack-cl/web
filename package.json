{
  "name": "agenticstack-web",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Sitio público de The Agentic Stack: radar tecnológico y blog",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && eslint --max-warnings 0 . && prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "links": "node scripts/check-links.mjs dist",
    "radar:validate": "python3 scripts/radar/validate.py src/data/radar.json",
    "radar:sync": "python3 scripts/radar/sync.py",
    "radar:metrics": "python3 scripts/radar/metrics.py",
    "test:py": "uvx pytest -q",
    "lint:py": "uvx ruff check scripts && uvx ruff format --check scripts",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.5",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
