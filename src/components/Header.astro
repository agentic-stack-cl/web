---
import { NAV, joinHref } from "@/config";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="sticky top-0 z-20 border-b border-slate-200/80 bg-white/90 backdrop-blur dark:border-brand-900 dark:bg-surface-dark/90">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="shrink-0 rounded-md" aria-label="The Agentic Stack, inicio">
      <Logo />
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-1">
        {NAV.map(({ href, label }) => (
          <li>
            <a
              href={href}
              aria-current={isActive(href) ? "page" : undefined}
              class="rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-brand-50 hover:text-brand-900 aria-[current=page]:text-brand-800 aria-[current=page]:underline aria-[current=page]:decoration-accent-500 aria-[current=page]:decoration-2 aria-[current=page]:underline-offset-8 dark:text-slate-300 dark:hover:bg-brand-900 dark:hover:text-white dark:aria-[current=page]:text-white"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a href={joinHref} class="btn-primary hidden sm:inline-flex">
        Únete
      </a>
      <ThemeToggle />
      <button
        type="button"
        id="nav-menu-open"
        aria-expanded="false"
        aria-controls="nav-drawer"
        aria-label="Abrir menú"
        class="inline-flex size-11 items-center justify-center rounded-lg text-brand-800 hover:bg-brand-50 md:hidden dark:text-brand-100 dark:hover:bg-brand-900"
      >
        <svg
          class="size-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<div
  id="nav-backdrop"
  class="fixed inset-0 z-40 bg-slate-900/50 backdrop-blur-md dark:bg-black/70"
  hidden
  aria-hidden="true"
></div>

<div
  id="nav-drawer"
  role="dialog"
  aria-modal="true"
  aria-label="Menú principal"
  class="fixed top-0 right-0 z-50 flex h-dvh w-80 max-w-[85vw] translate-x-full flex-col border-l border-slate-200 bg-white shadow-2xl transition-transform duration-300 ease-out dark:border-brand-800 dark:bg-brand-950"
  hidden
>
  <div class="flex h-16 items-center justify-between border-b border-slate-200 px-4 dark:border-brand-800">
    <span class="text-sm font-semibold text-brand-900 dark:text-white">Menú</span>
    <button
      type="button"
      id="nav-menu-close"
      aria-label="Cerrar menú"
      class="inline-flex size-11 items-center justify-center rounded-lg text-brand-800 hover:bg-brand-50 dark:text-brand-100 dark:hover:bg-brand-900"
    >
      <svg
        class="size-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>
  <nav aria-label="Principal (móvil)" class="flex-1 overflow-y-auto p-4">
    <ul class="space-y-1">
      {NAV.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={isActive(href) ? "page" : undefined}
            class="block min-h-12 rounded-lg px-4 py-3 text-lg font-medium text-slate-700 hover:bg-brand-50 hover:text-brand-900 aria-[current=page]:bg-brand-50 aria-[current=page]:font-semibold aria-[current=page]:text-brand-900 dark:text-slate-200 dark:hover:bg-brand-900 dark:aria-[current=page]:bg-brand-900 dark:aria-[current=page]:text-white"
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="border-t border-slate-200 p-4 dark:border-brand-800">
    <a href={joinHref} class="btn-primary w-full">
      Únete a la comunidad
    </a>
  </div>
</div>

<script>
  const openBtn = document.getElementById("nav-menu-open");
  const closeBtn = document.getElementById("nav-menu-close");
  const backdrop = document.getElementById("nav-backdrop");
  const drawer = document.getElementById("nav-drawer");
  if (openBtn && closeBtn && backdrop && drawer) {
    let lastFocus: HTMLElement | null = null;

    const open = () => {
      lastFocus = document.activeElement as HTMLElement | null;
      backdrop.hidden = false;
      drawer.hidden = false;
      // Fuerza un frame para que la transición de entrada se vea.
      requestAnimationFrame(() => drawer.classList.remove("translate-x-full"));
      openBtn.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
      closeBtn.focus();
    };

    const close = () => {
      drawer.classList.add("translate-x-full");
      openBtn.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
      const done = () => {
        drawer.hidden = true;
        backdrop.hidden = true;
      };
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) done();
      else drawer.addEventListener("transitionend", done, { once: true });
      lastFocus?.focus();
    };

    const isOpen = () => !drawer.hidden;

    openBtn.addEventListener("click", open);
    closeBtn.addEventListener("click", close);
    backdrop.addEventListener("click", close);
    drawer.querySelectorAll("a").forEach((a) => a.addEventListener("click", close));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) close();
    });
    matchMedia("(min-width: 768px)").addEventListener("change", (e) => {
      if (e.matches && isOpen()) close();
    });
  }
</script>
