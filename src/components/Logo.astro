---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { BRAND } from "@/lib/brand";
import { SITE } from "@/config";

// El SVG va en línea (no como <img>) para que sus textos usen Inter, que carga la
// página, y para poder aclarar el texto en modo oscuro con CSS sin tocar el archivo.
function inline(path: string | null): string | null {
  return path ? readFileSync(join(process.cwd(), "public", path), "utf8") : null;
}

const light = inline(BRAND.logoHorizontal);
const dark = inline(BRAND.logoHorizontalWhite);
const svgSize = "[&_svg]:h-10 [&_svg]:w-auto";
---

{light ? (
  <>
    <span
      role="img"
      aria-label={SITE.name}
      class:list={["block", svgSize, dark ? "dark:hidden" : "dark:[&_text]:fill-white"]}
      set:html={light}
    />
    {dark && (
      <span role="img" aria-label={SITE.name} class:list={["hidden dark:block", svgSize]} set:html={dark} />
    )}
  </>
) : (
  <span class="flex items-center gap-2 text-lg font-bold tracking-tight text-brand-800 dark:text-white">
    <span class="inline-block size-3 rounded-full bg-accent-500" aria-hidden="true" />
    {SITE.name}
  </span>
)}
