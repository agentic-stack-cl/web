---
import type { Post } from "@/lib/blog";
import { formatDate, isoDate } from "@/lib/blog";
interface Props {
  post: Post;
  headingLevel?: "h2" | "h3";
}
const { post, headingLevel: H = "h2" } = Astro.props;
---

<article class="card relative flex flex-col">
  <p class="text-sm text-slate-600 dark:text-slate-400">
    <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate)}</time>
    {post.data.draft && (
      <span class="ml-2 rounded bg-accent-100 px-1.5 py-0.5 text-xs font-semibold text-accent-900">
        Borrador
      </span>
    )}
  </p>
  <H class="mt-2 text-xl font-semibold tracking-tight text-brand-900 dark:text-white">
    <a href={`/blog/${post.id}`} class="after:absolute after:inset-0 hover:underline">
      {post.data.title}
    </a>
  </H>
  <p class="mt-2 text-slate-700 dark:text-slate-300">{post.data.description}</p>
  <ul class="relative z-10 mt-4 flex flex-wrap gap-2" aria-label="Etiquetas">
    {post.data.tags.map((tag) => (
      <li>
        <a
          href={`/blog/etiquetas/${tag}`}
          class="inline-flex min-h-9 items-center rounded-full bg-brand-50 px-3 py-1.5 text-xs font-medium text-brand-800 hover:bg-brand-100 dark:bg-brand-900 dark:text-brand-100 dark:hover:bg-brand-800"
        >
          #{tag}
        </a>
      </li>
    ))}
  </ul>
</article>
